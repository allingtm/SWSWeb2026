# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site Configuration
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=
CONTACT_EMAIL=

# SendGrid (all outbound email: contact, enquiries, Calendly, diagnostic callbacks)
# Without this, every notification is skipped and only the database record remains.
SENDGRID_API_KEY=
ENQUIRY_EMAIL=
CALENDLY_NOTIFICATION_EMAIL=

# OpenAI
OPENAI_API_KEY=

# Calendly
CALENDLY_ACCESS_TOKEN=

# Twilio SMS Notifications (Live Chat)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_NOTIFY_PHONE_NUMBER=+1234567890

# Aceternity UI (shadcn registry auth - build-time only, not used at runtime)
ACETERNITY_API_KEY=

# Upstash Redis (Rate Limiting)
KV_REST_API_READ_ONLY_TOKEN=
KV_REST_API_TOKEN=
KV_REST_API_URL=
KV_URL=
REDIS_URL=
